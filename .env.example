# ── Site ──
NEXT_PUBLIC_SITE_URL=https://www.mavastudio.ro
# Adresa CRM-ului folosită în linkurile din emailuri (ex. https://app.mavastudio.ro sau https://www.mavastudio.ro/crm)
NEXT_PUBLIC_CRM_URL=https://www.mavastudio.ro/crm

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Doar pe server (Vercel → Environment Variables). Nu-l pune niciodată în cod.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend – domeniul mavastudio.ro verificat) ──
RESEND_API_KEY=
EMAIL_FROM="MAVA Studio <contact@mavastudio.ro>"
ADMIN_NOTIFY_EMAIL=contact@mavastudio.ro

# Google Drive (Setări → Integrări). Din Google Cloud Console → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
